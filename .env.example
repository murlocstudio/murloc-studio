# Supabase Configuration for Murloc Studio
# Replace with your project details from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Next.js Public App URL (Used for Canonical URLs, OpenGraph, and Dynamic Sitemap)
NEXT_PUBLIC_SITE_URL=https://murlocstudio.com

# Studio Contact & Social Direct Settings (Fallback defaults)
NEXT_PUBLIC_STUDIO_PHONE=+90 212 555 0199
NEXT_PUBLIC_STUDIO_WHATSAPP=905300000000
NEXT_PUBLIC_STUDIO_EMAIL=info@murlocstudio.com
